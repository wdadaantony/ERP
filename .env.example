SECRET_KEY=cambiar-esto
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Descomenta cuando tengas Postgres corriendo:
# DATABASE_URL=postgres://erp:erp@localhost:5432/erp

# --- Solo para producción (DEBUG=0) ---
# ALLOWED_HOSTS=miapp.midominio.com
# CSRF_TRUSTED_ORIGINS=https://miapp.midominio.com
# SECURE_SSL_REDIRECT=1

# Adaptadores instalados; las claves son codigo:proveedor del Servicio externo.
ERP_CONNECTOR_BACKENDS={}
# Guardar referencias env:VARIABLE en credenciales, nunca claves reales aquí.
# EMPRESA_123_OSE_TOKEN=definir-en-el-servidor

# Recuperación de contraseñas: configurar y verificar entrega en cada servidor.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=ERP <noreply@localhost>
